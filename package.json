{
  "name": "lumidesk",
  "version": "0.1.0",
  "description": "LumiDesk AI desktop companion with multimodal chat, memory, Live2D, emotion, and voice support",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --config vite.config.ts",
    "dev:server": "cd server && npm run start:dev",
    "dev:all": "concurrently \"npm run dev:electron\" \"npm run dev:server\"",
    "build:server": "npm --prefix server run build",
    "prepare:electron-server": "node scripts/prepare-electron-server.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:electron": "npm run build && npm run build:server && npm run prepare:electron-server && electron-builder",
    "build:portable": "npm run build:electron && node scripts/export-portable.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  }
}
