# ──── LLM 配置 ────
LLM_PROVIDER=openai          # openai | claude | deepseek | qwen
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ──── VLM 视觉模型配置 ────
VLM_PROVIDER=openai          # openai | gemini | qwen-vl
VLM_API_KEY=your-api-key-here
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=gpt-4o

# ──── 数据库配置 ────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=ai_companion

# ──── Redis 配置 ────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ──── 向量数据库配置 ────
VECTOR_DB_PROVIDER=chroma     # chroma | milvus
CHROMA_URL=http://localhost:8000

# ──── 服务端口 ────
SERVER_PORT=3000
